<% @preheader = t("devise.mailer.reset_password_instructions.preheader") %>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
  <tr>
    <td style="padding-bottom: 16px;">
      <h1 style="margin: 0; font-family: -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif; font-size: 22px; line-height: 28px; font-weight: 600; letter-spacing: -0.02em; color: #F8FAFC;">
        <%= t("devise.mailer.reset_password_instructions.heading") %>
      </h1>
    </td>
  </tr>
  <tr>
    <td style="padding-bottom: 16px; font-family: -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif; font-size: 16px; line-height: 24px; color: #F8FAFC;">
      <p style="margin: 0 0 16px 0; font-family: -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif; font-size: 16px; line-height: 24px; color: #F8FAFC;">
        <%= t("devise.mailer.reset_password_instructions.greeting", email: @resource.email) %>
      </p>
      <p style="margin: 0; font-family: -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif; font-size: 16px; line-height: 24px; color: #F8FAFC;">
        <%= t("devise.mailer.reset_password_instructions.instruction") %>
      </p>
    </td>
  </tr>
  <tr>
    <td style="padding-top: 8px; padding-bottom: 24px;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td bgcolor="#6366F1" style="background-color: #6366F1;">
            <a href="<%= edit_password_url(@resource, reset_password_token: @token) %>" style="display: inline-block; padding-top: 14px; padding-bottom: 14px; padding-left: 24px; padding-right: 24px; font-family: -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif; font-size: 15px; line-height: 20px; font-weight: 600; color: #F8FAFC; text-decoration: none;">
              <%= t("devise.mailer.reset_password_instructions.action") %>
            </a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  <tr>
    <td style="padding-bottom: 8px; font-family: -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif; font-size: 14px; line-height: 22px; color: #94A3B8;">
      <p style="margin: 0; font-family: -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif; font-size: 14px; line-height: 22px; color: #94A3B8;">
        <%= t("devise.mailer.reset_password_instructions.ignore") %>
      </p>
    </td>
  </tr>
</table>
