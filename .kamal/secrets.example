# Copy to .kamal/secrets and keep that file local (it is gitignored).
# Do not put raw credentials in git. Values are read from local files at deploy time.

# Rails master key — decrypts config/credentials.yml.enc
RAILS_MASTER_KEY=$(cat config/master.key)

# Postgres accessory (POSTGRES_*) and Rails (PORTFOLIO_DATABASE_*). Same password.
# User/host/db name come from config/deploy.yml, not from this file.
# Generate once: openssl rand -hex 24 > .kamal/postgres.password
POSTGRES_PASSWORD=$(cat .kamal/postgres.password)
PORTFOLIO_DATABASE_PASSWORD=$POSTGRES_PASSWORD

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
# Site key is public (sent to the browser); secret key must stay private.
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
