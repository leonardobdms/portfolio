<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
  <tr>
    <td style="padding-bottom: 20px;">
      <h1 style="margin: 0; font-family: -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif; font-size: 22px; line-height: 28px; font-weight: 600; letter-spacing: -0.02em; color: #F8FAFC;">
        <%= t("contact.mailer.heading") %>
      </h1>
    </td>
  </tr>
  <tr>
    <td style="padding-bottom: 16px;">
      <p style="margin: 0 0 4px 0; font-family: -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif; font-size: 12px; line-height: 16px; letter-spacing: 0.04em; text-transform: uppercase; color: #94A3B8;">
        <%= t("activerecord.attributes.contact.name") %>
      </p>
      <p style="margin: 0; font-family: -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif; font-size: 16px; line-height: 24px; color: #F8FAFC;">
        <%= @contact.name %>
      </p>
    </td>
  </tr>
  <tr>
    <td style="padding-bottom: 16px;">
      <p style="margin: 0 0 4px 0; font-family: -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif; font-size: 12px; line-height: 16px; letter-spacing: 0.04em; text-transform: uppercase; color: #94A3B8;">
        <%= t("activerecord.attributes.contact.email") %>
      </p>
      <p style="margin: 0; font-family: -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif; font-size: 16px; line-height: 24px; color: #F8FAFC;">
        <a href="mailto:<%= @contact.email %>" style="font-family: -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif; font-size: 16px; line-height: 24px; color: #818CF8; text-decoration: underline;"><%= @contact.email %></a>
      </p>
    </td>
  </tr>
  <tr>
    <td style="padding-bottom: 24px;">
      <p style="margin: 0 0 4px 0; font-family: -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif; font-size: 12px; line-height: 16px; letter-spacing: 0.04em; text-transform: uppercase; color: #94A3B8;">
        <%= t("activerecord.attributes.contact.subject") %>
      </p>
      <p style="margin: 0; font-family: -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif; font-size: 16px; line-height: 24px; color: #F8FAFC;">
        <%= @contact.subject %>
      </p>
    </td>
  </tr>
  <tr>
    <td style="padding-bottom: 8px;">
      <p style="margin: 0 0 8px 0; font-family: -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif; font-size: 12px; line-height: 16px; letter-spacing: 0.04em; text-transform: uppercase; color: #94A3B8;">
        <%= t("activerecord.attributes.contact.message") %>
      </p>
    </td>
  </tr>
  <tr>
    <td style="padding-bottom: 28px;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" bgcolor="#1E293B" style="width: 100%; background-color: #1E293B;">
        <tr>
          <td style="padding-top: 20px; padding-bottom: 20px; padding-left: 20px; padding-right: 20px; border: 1px solid #334155; font-family: -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif; font-size: 16px; line-height: 24px; color: #F8FAFC; word-break: break-word;">
            <%= simple_format(
                  @contact.message,
                  {
                    style: "margin: 0 0 12px 0; font-family: -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif; font-size: 16px; line-height: 24px; color: #F8FAFC;"
                  }
                ) %>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  <tr>
    <td style="padding-bottom: 16px;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td bgcolor="#6366F1" style="background-color: #6366F1;">
            <a href="<%= @admin_contact_url %>" style="display: inline-block; padding-top: 14px; padding-bottom: 14px; padding-left: 24px; padding-right: 24px; font-family: -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif; font-size: 15px; line-height: 20px; font-weight: 600; color: #F8FAFC; text-decoration: none;">
              <%= t("contact.mailer.view_in_admin") %>
            </a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
