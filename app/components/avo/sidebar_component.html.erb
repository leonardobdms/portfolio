<%= content_tag :div,
  class: class_names(
    "avo-sidebar",
    "print:hidden": Avo.configuration.hide_layout_when_printing,
    "hidden": !@sidebar_open,
  ),
  data: {
    sidebar_target: stimulus_target
  } do %>
  <div class="sidebar__inner">
    <div class="sidebar__body mac-styled-scrollbar">
      <div class="sidebar__body-content">
        <div class="sidebar-section">
          <%= render Avo::Sidebar::HeadingComponent.new title: t("admin.sidebar.messages"), icon: "tabler/outline/mail" %>

          <%= render Avo::Sidebar::LinkComponent.new label: t("admin.sidebar.contacts"), path: helpers.avo.resources_contacts_path, icon: "tabler/outline/mail" %>
        </div>

        <div class="sidebar-section">
          <%= render Avo::Sidebar::HeadingComponent.new title: t("admin.sidebar.portfolio"), icon: "tabler/outline/user" %>

          <%= render Avo::Sidebar::LinkComponent.new label: t("admin.sidebar.profile"), path: helpers.avo.resources_profiles_path, icon: "tabler/outline/user" %>
          <%= render Avo::Sidebar::LinkComponent.new label: t("admin.sidebar.social_links"), path: helpers.avo.resources_social_links_path, icon: "tabler/outline/share" %>
        </div>

        <div class="sidebar-section">
          <%= render Avo::Sidebar::HeadingComponent.new title: t("admin.sidebar.career"), icon: "tabler/outline/briefcase" %>

          <%= render Avo::Sidebar::LinkComponent.new label: t("admin.sidebar.experiences"), path: helpers.avo.resources_experiences_path, icon: "tabler/outline/briefcase" %>
          <%= render Avo::Sidebar::LinkComponent.new label: t("admin.sidebar.education"), path: helpers.avo.resources_educations_path, icon: "tabler/outline/school" %>
          <%= render Avo::Sidebar::LinkComponent.new label: t("admin.sidebar.certifications"), path: helpers.avo.resources_certifications_path, icon: "tabler/outline/certificate" %>
        </div>

        <div class="sidebar-section">
          <%= render Avo::Sidebar::HeadingComponent.new title: t("admin.sidebar.work"), icon: "tabler/outline/layout-grid" %>

          <%= render Avo::Sidebar::LinkComponent.new label: t("admin.sidebar.projects"), path: helpers.avo.resources_projects_path, icon: "tabler/outline/layout-grid" %>
          <%= render Avo::Sidebar::LinkComponent.new label: t("admin.sidebar.skills"), path: helpers.avo.resources_skills_path, icon: "tabler/outline/code" %>
        </div>

        <% if dashboards.present? %>
          <div class="sidebar-section">
            <%= render Avo::Sidebar::HeadingComponent.new title: t("avo.dashboards"), icon: "tabler/outline/layout-dashboard" %>

            <% dashboards.sort_by { |dashboard| dashboard.navigation_label }.each do |dashboard| %>
              <%= render Avo::Sidebar::LinkComponent.new label: dashboard.navigation_label, path: helpers.avo_dashboards.dashboard_path(dashboard), hotkey: dashboard.try(:hotkey).presence, color: dashboard.try(:color) %>
            <% end %>
          </div>
        <% end %>

        <% if tools.present? %>
          <div class="sidebar-section">
            <%= render Avo::Sidebar::HeadingComponent.new title: t("avo.tools"), icon: "tabler/outline/tool" %>

            <% tools.each do |partial| %>
              <%= render partial: "/avo/sidebar/items/#{partial}" %>
            <% end %>
          </div>
        <% end %>

        <% if pages.present? %>
          <div class="sidebar-section">
            <%= render Avo::Sidebar::HeadingComponent.new title: t("avo.pages"), icon: "tabler/outline/forms" %>

            <% pages.each do |page| %>
              <%= render Avo::Sidebar::LinkComponent.new label: page.get_navigation_label, path: page.path %>
            <% end %>
          </div>
        <% end %>

        <% if Avo::MediaLibrary.configuration.visible? %>
          <%= render Avo::Sidebar::LinkComponent.new label: t("avo.media_library.title"), path: helpers.avo.media_library_index_path, active: :exclusive, icon: "tabler/outline/photo-star" %>
        <% end %>

        <%= render partial: "/avo/partials/sidebar_extra" %>
      </div>
    </div>
    <div class="sidebar__footer">
      <% if can_access_private_status? %>
        <div class="sidebar-status">
          <%= link_to helpers.avo.avo_private_status_path, class: "sidebar-status__link" do %>
            <span><%= t("admin.sidebar.avo_status") %></span>
            <span><div class="sidebar-status__indicator sidebar-status__indicator--<%= Avo.app_status %>"></div></span>
          <% end %>
        </div>
      <% end %>
      <%= render Avo::SidebarProfileComponent.new user: helpers._current_user %>
    </div>
  </div>
<% end %>
