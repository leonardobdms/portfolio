# Copy to .env.development.local (gitignored). Production values are injected by Kamal
# from .kamal/secrets (env.secret / builder.secrets) and config/deploy.yml env.clear.

# --- Database ---------------------------------------------------------------
# Used by config/database.yml. Local defaults are postgres / localhost / 5432
# if these are left blank. Production uses the Kamal accessory (user portfolio,
# host portfolio-db).
PORTFOLIO_DATABASE_USERNAME=
PORTFOLIO_DATABASE_PASSWORD=
PORTFOLIO_DATABASE_HOST=
PORTFOLIO_DATABASE_PORT=

# --- Cloudflare Turnstile ---------------------------------------------------
# Contact-form CAPTCHA. Site key is public (Inertia shared prop). Secret key is
# verified server-side; blank skips the remote check. The values below are
# Cloudflare's always-pass test keys for local development.
# https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Glitchtip / Sentry -----------------------------------------------------
# Optional. Rails SDK (config/initializers/sentry.rb) starts only when set,
# and only reports from production. Blank disables it.
SENTRY_DSN=

# Vue SDK (@sentry/vue). Vite inlines this at build time (VITE_*). Production
# image: Kamal builder secret, not a runtime env. Local `bin/dev` skips it
# (import.meta.env.PROD is false).
VITE_SENTRY_DSN=

# --- Umami analytics --------------------------------------------------------
# Optional production snippet (app/views/shared/_analytics.html.erb). Both
# must be set or nothing is rendered. The layout only includes it in production.
# Cloud: https://cloud.umami.is/script.js
# Self-hosted: https://analytics.example.com/script.js
ANALYTICS_SCRIPT_URL=
ANALYTICS_WEBSITE_ID=

# --- SMTP (Action Mailer) ---------------------------------------------------
# Production only. Development ignores these and sends through Mailpit on
# localhost:1025 (config/environments/development.rb). bin/dev does not start
# Mailpit — run it yourself if you want the inbox UI on localhost:8025.
#
# MAILER_HOST is the public site hostname used in email links (password reset,
# etc.). It is not the SMTP server — that is SMTP_HOST. MAILER_FROM is the From
# address for ContactMailer and Devise. Production sets both in
# config/deploy.yml env.clear (not secrets). Local mailers use localhost:3000
# and fall back to noreply@localhost if MAILER_FROM is unset.
MAILER_HOST=
MAILER_FROM=
SMTP_USER_NAME=
SMTP_PASSWORD=
SMTP_ADDRESS=
SMTP_HOST=
SMTP_PORT=
